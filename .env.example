# Copiază fișierul în .env.local și completează valorile (.env.local nu se pune în git).
# Aplicația, scripturile din prisma/ și CLI-ul Prisma (prin prisma.config.ts) citesc
# .env.local, apoi .env. NODE_ENV este setat automat de Next.js; nu îl pune aici.

# --- Bază de date (Supabase PostgreSQL) ---
# Conexiunea folosită de aplicație (Transaction pooler, portul 6543).
DATABASE_URL="postgresql://postgres.[ref]:[password]@[host]:6543/postgres?pgbouncer=true"
# Conexiunea directă (portul 5432), folosită de Prisma pentru migrări.
DIRECT_URL="postgresql://postgres.[ref]:[password]@[host]:5432/postgres"

# --- Autentificare (NextAuth) ---
# Adresa publică a aplicației; folosită și pentru linkurile din emailuri.
NEXTAUTH_URL="http://localhost:3000"
# Cheia de semnare a sesiunilor; generează cu: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Stocare PDF-uri (Supabase Storage, bucket-ul „cereri-concediu”) ---
# URL-ul proiectului Supabase.
NEXT_PUBLIC_SUPABASE_URL=""
# Cheia service role (doar pe server; nu o expune în browser).
SUPABASE_SERVICE_ROLE_KEY=""

# --- Emailuri (Resend) ---
# Cheia API Resend.
RESEND_API_KEY=""
# Expeditorul emailurilor; domeniul trebuie verificat în Resend.
EMAIL_FROM="noreply@example.ro"
# Doar pentru servere de test: scrie în log linkul de resetare a parolei când emailul nu pleacă. Ignorat în producția Vercel.
EMAIL_LOG_LINKS=""

# --- Joburi cron (Vercel Cron) ---
# Secretul pentru /api/cron/*, cel puțin 16 caractere; generează cu: openssl rand -hex 32
CRON_SECRET=""

# --- Limitarea autentificărilor (opțional, recomandat în producție) ---
# Cu Upstash Redis, limitele (5 eșecuri / 15 min pe utilizator + IP, 50 / 15 min pe IP)
# sunt comune tuturor instanțelor. Fără ele, limitele sunt ținute în memorie, pe fiecare instanță.
# URL-ul REST al bazei Upstash Redis.
UPSTASH_REDIS_REST_URL=""
# Tokenul REST al bazei Upstash Redis.
UPSTASH_REDIS_REST_TOKEN=""
# Numele vechi, setate de integrarea Vercel KV; folosite doar dacă cele de mai sus lipsesc.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- Aplicație ---
# Numele afișat în titlul paginii, pe pagina de login și în emailuri.
APP_NAME="Cereri Concediu"

# --- Seed administrator (npm run db:seed) ---
# Contul de administrator creat dacă nu există; la prima autentificare cere schimbarea parolei.
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.ro"
ADMIN_PASSWORD="SchimbaParola123!"
# Numele firmei: apare sub numele aplicației în antetul fiecărei pagini și e angajatorul
# implicit pentru conturile create cu db:seed și db:create-employee.
COMPANY_NAME="Compania Ta SRL"

# Doar pentru instanța publică de demo (date fictive). DEMO_MODE=true permite `npm run db:seed-demo`
# (ȘTERGE baza) și protejează conturile demo; NEXT_PUBLIC_DEMO_MODE=true afișează butoanele de intrare.
DEMO_MODE=""
NEXT_PUBLIC_DEMO_MODE=""
