# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[ref]:[password]@[host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@[host]:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # generează cu: openssl rand -base64 32

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="cereri-concediu"

# Resend
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.ro"

# Bootstrap admin (folosit la seed)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.ro"
ADMIN_PASSWORD="SchimbaParola123!"

# Cron security
CRON_SECRET="" # cel puțin 16 caractere; generează cu: openssl rand -hex 32

# Upstash Redis (opțional, recomandat în producție): limitele de autentificare
# (5 eșecuri / 15 min pe utilizator + IP, 50 / 15 min pe IP) devin comune tuturor
# instanțelor. Fără ele, limitele sunt ținute în memorie, pe fiecare instanță.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Numele vechi, setate de integrarea Vercel KV; folosite doar dacă cele de mai sus lipsesc.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Aplicație
APP_NAME="Cereri Concediu"
COMPANY_NAME="Compania Ta SRL"
